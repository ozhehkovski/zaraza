{
  "name": "telegram-price-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:live": "tsx scripts/live.ts",
    "test:load": "tsx scripts/load.ts",
    "migrate": "tsx src/database/migrate.ts",
    "format": "prettier --write src scripts tests README.md docs/*.md"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.38.3",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "playwright": "^1.56.0",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@types/pg": "^8.15.5",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
